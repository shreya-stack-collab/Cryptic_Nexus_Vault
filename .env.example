# Copy this file to .env and fill in your Gmail SMTP App Password.
# Do not put your normal Google account password here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-account@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password
SMTP_FROM=your-sending-account@gmail.com
# Optional: stable Flask session signing key. Generate a long random value.
CNV_SESSION_SECRET=replace-with-a-long-random-secret
# Optional: set an administrator password (16+ characters) instead of the generated local password.
# CNV_ADMIN_USERNAME=shreya
# CNV_ADMIN_PASSWORD=shreyathedeveloper

# Optional LAN mode: change to 0.0.0.0 only on a trusted private network. Default is local-only.
# CNV_HOST=0.0.0.0
